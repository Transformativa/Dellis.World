{
  "name": "dellis-world",
  "version": "1.0.0",
  "private": true,
  "description": "All World People Encyclopedia by Dellis. A static site with monthly-refreshed world facts.",
  "scripts": {
    "test": "node --test",
    "refresh": "node scripts/refresh.mjs",
    "refresh:seed": "node scripts/refresh.mjs --seed scripts/seed/worldbank-2026-10-10.json",
    "serve": "python3 -m http.server 8000",
    "check": "bash scripts/run-tests.sh",
    "check:full": "bash scripts/run-tests.sh --full",
    "release-check": "bash scripts/run-tests.sh --release",
    "visual": "node scripts/visual-check.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
